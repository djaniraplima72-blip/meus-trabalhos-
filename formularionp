<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Proposta de Locação - Nova Progresso</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #003366;
            --secondary-color: #00509e;
            --accent-color: #c9a84c;
            --bg-color: #f4f6f9;
            --card-bg: #ffffff;
            --text-color: #333333;
            --text-light: #666666;
            --border-color: #e0e0e0;
            --success-color: #28a745;
            --error-color: #dc3545;
            --radius: 8px;
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            line-height: 1.6;
            padding: 20px;
        }

        /* Header com Logo ao lado do Título */
        .header { 
            background: linear-gradient(135deg, #001a33 0%, #003366 100%);
            padding: 20px;
            border-radius: var(--radius);
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }
        
        .logo-container {
            display: flex;
            align-items: center;
        }

        .logo-container img {
            max-width: 120px;
            height: auto;
        }

        .header-text {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            border-left: 2px solid rgba(255,255,255,0.3);
            padding-left: 20px;
        }

        .header-text h1 { 
            font-size: 1.5rem; 
            color: white; 
            font-weight: 700;
            margin-bottom: 5px;
        }

        .header-text h2 { 
            font-weight: 400; 
            color: rgba(255,255,255,0.8); 
            font-size: 1rem; 
        }

        .card {
            background-color: var(--card-bg); 
            border-radius: var(--radius);
            box-shadow: var(--shadow); 
            max-width: 900px; 
            margin: 0 auto;
            padding: 40px; 
            border-top: 5px solid var(--accent-color);
        }

        .section-title {
            font-size: 1.25rem; 
            font-weight: 700; 
            color: var(--primary-color);
            margin-bottom: 20px; 
            padding-bottom: 10px; 
            border-bottom: 2px solid var(--border-color);
            display: flex; 
            align-items: center; 
            gap: 10px;
        }

        .section-title span {
            background-color: var(--primary-color); 
            color: white; 
            width: 30px; 
            height: 30px;
            display: flex; 
            align-items: center; 
            justify-content: center;
            border-radius: 50%; 
            font-size: 0.9rem;
        }

        .form-grid { 
            display: grid; 
            grid-template-columns: repeat(2, 1fr); 
            gap: 20px; 
            margin-bottom: 30px; 
        }
        .form-group { display: flex; flex-direction: column; }
        .form-group.full-width { grid-column: span 2; }

        label { 
            font-size: 0.9rem; 
            font-weight: 500; 
            margin-bottom: 6px; 
            color: var(--text-color); 
        }
        
        input[type="text"], input[type="email"], input[type="tel"], input[type="number"], 
        input[type="date"], select, textarea {
            padding: 12px; 
            border: 1px solid var(--border-color); 
            border-radius: var(--radius);
            font-family: 'Inter', sans-serif; 
            font-size: 1rem; 
            transition: border-color 0.2s;
        }

        input:focus, select:focus, textarea:focus {
            outline: none; 
            border-color: var(--secondary-color);
            box-shadow: 0 0 0 3px rgba(0, 80, 158, 0.1);
        }

        /* Botões de Garantia */
        .garantia-options {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        .garantia-option {
            display: none; /* Esconde o radio button nativo */
        }

        .garantia-label {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 15px;
            border: 2px solid var(--border-color);
            border-radius: var(--radius);
            cursor: pointer;
            font-weight: 600;
            color: var(--text-light);
            transition: all 0.2s;
            text-align: center;
        }

        .garantia-option:checked + .garantia-label {
            border-color: var(--primary-color);
            background-color: #e8edf2;
            color: var(--primary-color);
            box-shadow: 0 2px 8px rgba(0, 51, 102, 0.15);
        }

        /* Botões Gerais */
        .btn {
            padding: 12px 24px; 
            border: none; 
            border-radius: var(--radius); 
            cursor: pointer;
            font-weight: 600; 
            font-size: 1rem; 
            transition: background 0.2s; 
            text-align: center;
        }
        .btn-primary { 
            background: linear-gradient(135deg, var(--accent-color) 0%, #b8953f 100%); 
            color: var(--primary-color); 
            width: 100%; 
            margin-top: 20px; 
        }
        .btn-primary:hover { 
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(201, 168, 76, 0.4);
        }
        .btn-secondary {
            background-color: white; 
            border: 2px solid var(--primary-color); 
            color: var(--primary-color);
            width: 100%; 
            margin-bottom: 20px;
        }
        .btn-secondary:hover { background-color: #eef2f6; }

        /* Blocos de Pretendentes */
        .pretender-block {
            background-color: #f9f9f9; 
            border: 1px solid var(--border-color);
            border-radius: var(--radius); 
            padding: 20px; 
            margin-bottom: 20px;
            position: relative; 
            animation: fadeIn 0.3s ease-in-out;
        }
        @keyframes fadeIn { 
            from { opacity: 0; transform: translateY(10px); } 
            to { opacity: 1; transform: translateY(0); } 
        }
        
        .pretender-header { 
            font-weight: 600; 
            margin-bottom: 15px; 
            color: var(--secondary-color); 
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
        }
        .btn-remove { 
            background: none; 
            border: none; 
            color: var(--error-color); 
            cursor: pointer; 
            font-size: 0.85rem; 
            font-weight: 600; 
        }

        /* Upload */
        .upload-area {
            border: 2px dashed var(--border-color); 
            border-radius: var(--radius); 
            padding: 20px;
            text-align: center; 
            cursor: pointer; 
            transition: background 0.2s; 
            margin-bottom: 20px;
        }
        .upload-area:hover { background-color: #f9f9f9; border-color: var(--secondary-color); }
        .upload-icon { font-size: 2rem; color: var(--text-light); margin-bottom: 10px; }

        /* Assinatura */
        .signature-pad-container {
            border: 1px solid var(--border-color); 
            border-radius: var(--radius);
            overflow: hidden; 
            margin-bottom: 20px; 
            position: relative; 
            height: 200px; 
            background-color: white;
        }
        canvas { width: 100%; height: 100%; cursor: crosshair; }
        .signature-actions { position: absolute; top: 10px; right: 10px; }
        .btn-clear-sig { 
            padding: 5px 10px; 
            font-size: 0.8rem; 
            background: var(--error-color); 
            color: white; 
            border: none; 
            border-radius: 4px; 
            cursor: pointer; 
        }

        /* Checkbox */
        .checkbox-group { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 20px; }
        .checkbox-group input { margin-top: 5px; width: 18px; height: 18px; }

        /* Captcha Box */
        .action-box {
            background: linear-gradient(135deg, #f0f4f8 0%, #e8edf2 100%); 
            border: 1px solid var(--secondary-color);
            border-radius: var(--radius); 
            padding: 20px; 
            margin-top: 30px;
            display: flex; 
            align-items: center; 
            justify-content: space-between; 
            flex-wrap: wrap; 
            gap: 20px;
        }
        .action-box h3 { color: var(--primary-color); margin-bottom: 5px; font-size: 1.1rem; }
        .action-box p { font-size: 0.9rem; color: var(--text-light); }
        .captcha-area { display: flex; align-items: center; gap: 10px; }

        .success-message {
            display: none; 
            background-color: #d4edda; 
            color: #155724; 
            padding: 20px;
            border-radius: var(--radius); 
            margin-top: 20px; 
            text-align: center; 
            border: 1px solid #c3e6cb;
        }

        @media (max-width: 768px) {
            .form-grid { grid-template-columns: 1fr; }
            .form-group.full-width { grid-column: span 1; }
            .card { padding: 20px; }
            .action-box { flex-direction: column; text-align: center; }
            .captcha-area { width: 100%; justify-content: center; }
            .header { flex-direction: column; }
            .header-text { border-left: none; padding-left: 0; align-items: center; border-top: 1px solid rgba(255,255,255,0.3); padding-top: 15px; }
        }
    </style>
</head>
<body>

    <div class="header">
        <div class="logo-container">
            <img src="https://image.qwenlm.ai/public_source/82ad31f9-2fe2-4117-9b2b-1733be0e1736/134652a0c-c035-4792-a77c-2032c0ec21c6.png" alt="Nova Progresso Logo">
        </div>
        <div class="header-text">
            <h1>PROPOSTA PARA LOCAÇÃO DE IMÓVEL</h1>
            <h2>Preencha todos os campos obrigatórios com atenção.</h2>
        </div>
    </div>

    <div class="card">
        <form id="rentalForm">
            
            <!-- Seção I: Imóvel -->
            <div class="section-title"><span>I</span> Dados do Imóvel</div>
            <div class="form-grid">
                <div class="form-group"><label for="edificio">Edifício</label><input type="text" id="edificio" name="edificio" required></div>
                <div class="form-group"><label for="unidade">Unidade / Nº</label><input type="text" id="unidade" name="unidade" required></div>
                <div class="form-group full-width"><label for="endereco">Endereço</label><input type="text" id="endereco" name="endereco" required></div>
                <div class="form-group"><label for="bairro">Bairro</label><input type="text" id="bairro" name="bairro" required></div>
                <div class="form-group"><label for="cidade">Cidade</label><input type="text" id="cidade" name="cidade" required></div>
                <div class="form-group"><label for="uf">U.F.</label><input type="text" id="uf" name="uf" value="SP" required></div>
            </div>

            <!-- Seção II: Pretendente Principal -->
            <div class="section-title"><span>II</span> Dados do Pretendente (Principal)</div>
            <div class="form-grid">
                <div class="form-group full-width"><label for="nome_principal">Nome Completo <span style="color:red">*</span></label><input type="text" id="nome_principal" name="nome_principal" required></div>
                <div class="form-group"><label for="email_principal">E-mail <span style="color:red">*</span></label><input type="email" id="email_principal" name="email_principal" required></div>
                <div class="form-group"><label for="cpf_principal">CPF <span style="color:red">*</span></label><input type="text" id="cpf_principal" name="cpf_principal" required></div>
                <div class="form-group"><label for="rg_principal">Identidade Nº <span style="color:red">*</span></label><input type="text" id="rg_principal" name="rg_principal" required></div>
                <div class="form-group"><label for="orgao_emissor_principal">Emitido por <span style="color:red">*</span></label><input type="text" id="orgao_emissor_principal" name="orgao_emissor_principal" value="SSP" required></div>
                <div class="form-group"><label for="nascimento_principal">Data de Nascimento <span style="color:red">*</span></label><input type="date" id="nascimento_principal" name="nascimento_principal" required></div>
                <div class="form-group"><label for="profissao_principal">Profissão <span style="color:red">*</span></label><input type="text" id="profissao_principal" name="profissao_principal" required></div>
                <div class="form-group"><label for="naturalidade_principal">Naturalidade</label><input type="text" id="naturalidade_principal" name="naturalidade_principal"></div>
                <div class="form-group"><label for="estado_civil_principal">Estado Civil <span style="color:red">*</span></label>
                    <select id="estado_civil_principal" name="estado_civil_principal" required>
                        <option value="">Selecione...</option>
                        <option value="Solteiro">Solteiro(a)</option>
                        <option value="Casado">Casado(a)</option>
                        <option value="Divorciado">Divorciado(a)</option>
                        <option value="Viúvo">Viúvo(a)</option>
                    </select>
                </div>
                <div class="form-group full-width"><label>Endereço do Pretendente</label></div>
                <div class="form-group full-width"><input type="text" id="endereco_principal" name="endereco_principal" placeholder="Rua, Av..." required></div>
                <div class="form-group"><input type="text" id="num_end_principal" name="num_end_principal" placeholder="Nº" required></div>
                <div class="form-group"><input type="text" id="bairro_end_principal" name="bairro_end_principal" placeholder="Bairro" required></div>
                <div class="form-group"><input type="text" id="cidade_end_principal" name="cidade_end_principal" placeholder="Cidade" required></div>
                <div class="form-group"><input type="text" id="uf_end_principal" name="uf_end_principal" placeholder="UF" value="SP" required></div>
                <div class="form-group"><label for="tel_com_principal">Tel. Comercial</label><input type="tel" id="tel_com_principal" name="tel_com_principal"></div>
                <div class="form-group"><label for="tel_res_principal">Tel. Residencial</label><input type="tel" id="tel_res_principal" name="tel_res_principal"></div>
                <div class="form-group"><label for="cel_principal">Celular <span style="color:red">*</span></label><input type="tel" id="cel_principal" name="cel_principal" required></div>
            </div>

            <!-- Container para Pretendentes Adicionais -->
            <div id="pretendersContainer"></div>

            <button type="button" class="btn btn-secondary" id="addPretenderBtn">+ Adicionar Pretendente</button>

            <!-- Seção III: Condições e Garantias -->
            <div class="section-title" style="margin-top: 30px;"><span>III</span> Condições e Garantias</div>
            <div class="form-grid">
                <div class="form-group full-width">
                    <label for="valor_aluguel">Valor do Aluguel Proposto (R$) <span style="color:red">*</span></label>
                    <input type="number" id="valor_aluguel" name="valor_aluguel" step="0.01" required>
                </div>
                <div class="form-group full-width">
                    <label for="condicoes">Observações</label>
                    <textarea id="condicoes" name="condicoes" rows="3" placeholder="Outras condições..."></textarea>
                </div>
            </div>

            <label style="font-weight:700; color:var(--primary-color); margin-bottom:10px; display:block;">Selecione o Tipo de Garantia <span style="color:red">*</span></label>
            <div class="garantia-options">
                <input type="radio" name="tipo_garantia" id="g_caucao" value="Caução" class="garantia-option" required onchange="toggleFiador()">
                <label for="g_caucao" class="garantia-label">Caução</label>

                <input type="radio" name="tipo_garantia" id="g_seguro" value="Seguro Fiança" class="garantia-option" onchange="toggleFiador()">
                <label for="g_seguro" class="garantia-label">Seguro Fiança</label>

                <input type="radio" name="tipo_garantia" id="g_titulo" value="Título de Capitalização" class="garantia-option" onchange="toggleFiador()">
                <label for="g_titulo" class="garantia-label">Título de Capitalização</label>

                <input type="radio" name="tipo_garantia" id="g_fiador" value="Fiador" class="garantia-option" onchange="toggleFiador()">
                <label for="g_fiador" class="garantia-label">Fiador</label>
            </div>

            <!-- Seção IV: Fiador (Condicional) -->
            <div id="fiadorSection" style="display:none; background-color: #fff8f8; padding: 20px; border: 1px solid #ffcccc; border-radius: 8px; margin-bottom: 20px;">
                <div class="section-title" style="margin-top:0; color:#d32f2f;"><span>IV</span> Dados do Fiador (Obrigatório)</div>
                <div class="form-grid">
                    <div class="form-group full-width"><label for="nome_fiador">Nome Completo <span style="color:red">*</span></label><input type="text" id="nome_fiador" name="nome_fiador"></div>
                    <div class="form-group"><label for="email_fiador">E-mail <span style="color:red">*</span></label><input type="email" id="email_fiador" name="email_fiador"></div>
                    <div class="form-group"><label for="cpf_fiador">CPF <span style="color:red">*</span></label><input type="text" id="cpf_fiador" name="cpf_fiador"></div>
                    <div class="form-group"><label for="rg_fiador">Identidade Nº <span style="color:red">*</span></label><input type="text" id="rg_fiador" name="rg_fiador"></div>
                    <div class="form-group"><label for="orgao_emissor_fiador">Emitido por <span style="color:red">*</span></label><input type="text" id="orgao_emissor_fiador" name="orgao_emissor_fiador" value="SSP"></div>
                    <div class="form-group"><label for="nascimento_fiador">Data de Nascimento <span style="color:red">*</span></label><input type="date" id="nascimento_fiador" name="nascimento_fiador"></div>
                    <div class="form-group"><label for="profissao_fiador">Profissão <span style="color:red">*</span></label><input type="text" id="profissao_fiador" name="profissao_fiador"></div>
                    <div class="form-group"><label for="naturalidade_fiador">Naturalidade</label><input type="text" id="naturalidade_fiador" name="naturalidade_fiador"></div>
                    <div class="form-group"><label for="estado_civil_fiador">Estado Civil <span style="color:red">*</span></label>
                        <select id="estado_civil_fiador" name="estado_civil_fiador">
                            <option value="">Selecione...</option>
                            <option value="Solteiro">Solteiro(a)</option>
                            <option value="Casado">Casado(a)</option>
                            <option value="Divorciado">Divorciado(a)</option>
                            <option value="Viúvo">Viúvo(a)</option>
                        </select>
                    </div>
                    <div class="form-group full-width"><label>Endereço do Fiador</label></div>
                    <div class="form-group full-width"><input type="text" id="endereco_fiador" name="endereco_fiador" placeholder="Rua, Av..."></div>
                    <div class="form-group"><input type="text" id="num_end_fiador" name="num_end_fiador" placeholder="Nº"></div>
                    <div class="form-group"><input type="text" id="bairro_end_fiador" name="bairro_end_fiador" placeholder="Bairro"></div>
                    <div class="form-group"><input type="text" id="cidade_end_fiador" name="cidade_end_fiador" placeholder="Cidade"></div>
                    <div class="form-group"><input type="text" id="uf_end_fiador" name="uf_end_fiador" placeholder="UF" value="SP"></div>
                    <div class="form-group"><label for="tel_com_fiador">Tel. Comercial</label><input type="tel" id="tel_com_fiador" name="tel_com_fiador"></div>
                    <div class="form-group"><label for="tel_res_fiador">Tel. Residencial</label><input type="tel" id="tel_res_fiador" name="tel_res_fiador"></div>
                    <div class="form-group"><label for="cel_fiador">Celular <span style="color:red">*</span></label><input type="tel" id="cel_fiador" name="cel_fiador"></div>
                </div>
            </div>

            <!-- Seção V: Upload -->
            <div class="section-title" style="margin-top: 30px;"><span>V</span> Upload de Documentos</div>
            <div class="upload-area" onclick="document.getElementById('fileInput').click()">
                <div class="upload-icon">📁</div>
                <p>Clique para anexar documentos (RG, CPF, Comprovantes)</p>
                <input type="file" id="fileInput" name="fileInput" multiple style="display: none;" onchange="updateFileNames()">
            </div>
            <div id="fileList" style="margin-bottom: 20px; font-size: 0.9rem; color: var(--text-light);"></div>

            <!-- Seção VI: Assinatura -->
            <div class="section-title" style="margin-top: 30px;"><span>VI</span> Assinatura Eletrônica</div>
            <div class="signature-pad-container">
                <canvas id="signaturePad"></canvas>
                <div class="signature-actions"><button type="button" class="btn-clear-sig" id="clearSig">Limpar</button></div>
            </div>

            <div class="checkbox-group">
                <input type="checkbox" id="terms" required>
                <label for="terms">Declaro que as informações acima são verdadeiras e estou ciente das condições da proposta.</label>
            </div>

            <!-- Seção VII: Captcha e Envio Fixo -->
            <div class="action-box">
                <div>
                    <h3>Enviar para o Departamento Jurídico</h3>
                    <p>A proposta será enviada para: <strong>juridico@novaprogresso.com.br</strong></p>
                </div>
                <div class="captcha-area">
                    <label for="captcha"><strong>CAPTCHA:</strong> <span id="captchaQuestion"></span> = </label>
                    <input type="number" id="captcha" required style="width: 80px; padding: 8px;">
                    <button type="submit" class="btn btn-primary" style="width: auto; margin-top: 0; margin-left: 10px;">Enviar Proposta</button>
                </div>
            </div>
        </form>

        <div class="success-message" id="successMessage">
            Verificando dados...
        </div>
    </div>

    <script>
        // Lógica de Pretendentes
        const container = document.getElementById('pretendersContainer');
        const addBtn = document.getElementById('addPretenderBtn');
        let pretenderCount = 0;
        const maxPretenders = 4;

        addBtn.addEventListener('click', () => {
            if (pretenderCount >= maxPretenders) { alert("Limite máximo de 5 pretendentes atingido."); return; }
            pretenderCount++;
            const block = document.createElement('div');
            block.className = 'pretender-block';
            block.id = `pretender-${pretenderCount}`;
            const p = pretenderCount;
            
            block.innerHTML = `
                <div class="pretender-header">
                    <span>Pretendente ${p + 1}</span>
                    <button type="button" class="btn-remove" onclick="removePretender(${p})">Remover</button>
                </div>
                <div class="form-grid">
                    <div class="form-group full-width"><label>Nome Completo</label><input type="text" id="nome_add_${p}" required></div>
                    <div class="form-group"><label>CPF</label><input type="text" id="cpf_add_${p}" required></div>
                    <div class="form-group"><label>Identidade Nº</label><input type="text" id="rg_add_${p}" required></div>
                    <div class="form-group full-width"><label>Endereço</label><input type="text" id="end_add_${p}" placeholder="Rua..." required></div>
                    <div class="form-group"><input type="text" id="num_add_${p}" placeholder="Nº" required></div>
                    <div class="form-group"><input type="text" id="bairro_add_${p}" placeholder="Bairro" required></div>
                    <div class="form-group"><input type="text" id="cel_add_${p}" placeholder="Celular" required></div>
                </div>
            `;
            container.appendChild(block);
            if (pretenderCount >= maxPretenders) addBtn.style.display = 'none';
        });

        window.removePretender = function(id) {
            const block = document.getElementById(`pretender-${id}`);
            block.remove();
            pretenderCount--;
            addBtn.style.display = 'block';
        };

        // Lógica de Arquivos
        const fileInput = document.getElementById('fileInput');
        const fileList = document.getElementById('fileList');
        function updateFileNames() {
            const files = fileInput.files;
            fileList.innerHTML = '';
            for (let i = 0; i < files.length; i++) fileList.innerHTML += `<p>📎 ${files[i].name}</p>`;
        }

        // Lógica de Assinatura
        const canvas = document.getElementById('signaturePad');
        const ctx = canvas.getContext('2d');
        let isDrawing = false;

        function resizeCanvas() {
            const rect = canvas.parentElement.getBoundingClientRect();
            canvas.width = rect.width; canvas.height = rect.height;
            ctx.strokeStyle = "#000"; ctx.lineWidth = 2;
        }
        window.addEventListener('load', resizeCanvas);
        window.addEventListener('resize', resizeCanvas);

        function getPos(e) {
            const rect = canvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return { x: clientX - rect.left, y: clientY - rect.top };
        }

        canvas.addEventListener('mousedown', (e) => { isDrawing = true; const pos = getPos(e); ctx.beginPath(); ctx.moveTo(pos.x, pos.y); });
        canvas.addEventListener('mousemove', (e) => { if (!isDrawing) return; const pos = getPos(e); ctx.lineTo(pos.x, pos.y); ctx.stroke(); });
        canvas.addEventListener('mouseup', () => isDrawing = false);
        canvas.addEventListener('mouseleave', () => isDrawing = false);
        canvas.addEventListener('touchstart', (e) => { e.preventDefault(); isDrawing = true; const pos = getPos(e); ctx.beginPath(); ctx.moveTo(pos.x, pos.y); });
        canvas.addEventListener('touchmove', (e) => { e.preventDefault(); if (!isDrawing) return; const pos = getPos(e); ctx.lineTo(pos.x, pos.y); ctx.stroke(); });
        canvas.addEventListener('touchend', () => isDrawing = false);
        document.getElementById('clearSig').addEventListener('click', () => { ctx.clearRect(0, 0, canvas.width, canvas.height); });

        // Lógica de Garantia (Mostrar/Ocultar Fiador)
        function toggleFiador() {
            const fiadorSection = document.getElementById('fiadorSection');
            const inputs = fiadorSection.querySelectorAll('input, select');
            
            const isFiador = document.getElementById('g_fiador').checked;
            
            if (isFiador) {
                fiadorSection.style.display = 'block';
                inputs.forEach(input => input.setAttribute('required', 'required'));
            } else {
                fiadorSection.style.display = 'none';
                inputs.forEach(input => input.removeAttribute('required'));
            }
        }

        // Lógica de Captcha e Envio
        let num1 = Math.floor(Math.random() * 10) + 1;
        let num2 = Math.floor(Math.random() * 10) + 1;
        document.getElementById('captchaQuestion').textContent = `${num1} + ${num2}`;

        document.getElementById('rentalForm').addEventListener('submit', function(e) {
            e.preventDefault();

            // Verificar Captcha
            const userAnswer = parseInt(document.getElementById('captcha').value);
            if (userAnswer !== (num1 + num2)) {
                alert("Resposta do Captcha incorreta. Tente novamente.");
                return;
            }

            // Destinatário Fixo
            const destEmail = "juridico@novaprogresso.com.br";

            // Obter Garantia Selecionada
            let garantiaSelecionada = document.querySelector('input[name="tipo_garantia"]:checked');
            if (!garantiaSelecionada) {
                alert("Por favor, selecione um tipo de garantia.");
                return;
            }
            let garantiaTexto = garantiaSelecionada.value;

            // Construir Corpo do E-mail
            const subject = `Proposta de Locação - ${document.getElementById('nome_principal').value}`;
            let body = `NOVA PROGRESSO - PROPOSTA DE LOCAÇÃO\n\n`;
            
            body += `DADOS DO IMÓVEL:\n`;
            body += `Edifício: ${document.getElementById('edificio').value}\n`;
            body += `Endereço: ${document.getElementById('endereco').value}, ${document.getElementById('unidade').value}\n`;
            body += `Bairro: ${document.getElementById('bairro').value}, ${document.getElementById('cidade').value}/${document.getElementById('uf').value}\n\n`;

            body += `DADOS DO PRETENDENTE PRINCIPAL:\n`;
            body += `Nome: ${document.getElementById('nome_principal').value}\n`;
            body += `CPF: ${document.getElementById('cpf_principal').value}\n`;
            body += `Email: ${document.getElementById('email_principal').value}\n`;
            body += `Endereço: ${document.getElementById('endereco_principal').value}\n\n`;

            for (let i = 1; i <= pretenderCount; i++) {
                const nome = document.getElementById(`nome_add_${i}`).value;
                if (nome) {
                    body += `PRETENDENTE ADICIONAL ${i}:\n`;
                    body += `Nome: ${nome}\n`;
                    body += `CPF: ${document.getElementById(`cpf_add_${i}`).value}\n\n`;
                }
            }

            body += `CONDIÇÕES:\n`;
            body += `Valor: R$ ${document.getElementById('valor_aluguel').value}\n`;
            body += `Garantia: ${garantiaTexto}\n`;
            
            if (garantiaTexto === 'Fiador') {
                body += `\nDADOS DO FIADOR:\n`;
                body += `Nome: ${document.getElementById('nome_fiador').value}\n`;
                body += `CPF: ${document.getElementById('cpf_fiador').value}\n`;
                body += `Email: ${document.getElementById('email_fiador').value}\n`;
                body += `Endereço: ${document.getElementById('endereco_fiador').value}\n`;
            }

            const mailtoLink = `mailto:${destEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
            
            const successMsg = document.getElementById('successMessage');
            successMsg.style.display = 'block';
            successMsg.innerHTML = "Proposta gerada com sucesso! Abrindo seu aplicativo de e-mail para envio...";
            
            setTimeout(() => { window.location.href = mailtoLink; }, 1500);
        });
    </script>
</body>
</html>

